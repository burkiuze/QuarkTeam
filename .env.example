# Optional defaults for development. Real environment variables always win, and
# every value can also be set from QuarkCode > AI settings at runtime.
# Copy this file to .env and fill in your own credentials.
QUARK_PROVIDER=opencode-zen
QUARK_BASE_URL=https://opencode.ai/zen/v1
QUARK_PROTOCOL=openai-responses
QUARK_MODEL=muse-spark-1.3-contributor-free
QUARK_API_KEY=
